<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wallpaper">

    <!-- ===== .aurora-one/two/three (nằm dưới nội dung) ===== -->
    <View
        android:id="@+id/auroraOne"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="-80dp"
        android:background="@drawable/bg_aurora_one" />

    <View
        android:id="@+id/auroraTwo"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="140dp"
        android:layout_marginEnd="-120dp"
        android:background="@drawable/bg_aurora_two" />

    <View
        android:id="@+id/auroraThree"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="-120dp"
        android:background="@drawable/bg_aurora_three" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- ===== .topbar ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_brand_mark">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_spark" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Daylight"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_weather_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="17°"
                    android:textColor="#C7FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ===== .ambient-copy (giãn ra, đẩy card xuống đáy) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingTop="56dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wednesday, October 21"
                    android:textColor="#A8FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.06"
                    android:text="09:41"
                    android:textColor="#F5FFFFFF"
                    android:textSize="88sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Make space for what matters."
                    android:textColor="#A8FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- ===== .todo-card ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_glass_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <!-- .card-heading -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingTop="23dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="17dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:text="MY DAY"
                            android:textColor="#8CFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="-0.03"
                            android:text="Today"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnMore"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="More options"
                        android:padding="9dp"
                        android:src="@drawable/ic_more" />
                </LinearLayout>

                <!-- .task-summary -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/tvLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 tasks left"
                        android:textColor="#8FFFFFFF"
                        android:textSize="12sp" />

                    <ProgressBar
                        android:id="@+id/progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:indeterminate="false"
                        android:max="100"
                        android:maxHeight="3dp"
                        android:minHeight="3dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_task" />
                </LinearLayout>

                <!-- .task-list -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1AFFFFFF" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never" />

                <!-- .add-button -->
                <LinearLayout
                    android:id="@+id/btnAddRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_add_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingTop="19dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="21dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_plus" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:text="Add a new task"
                        android:textColor="#A3FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- .add-form (ẩn mặc định) -->
                <LinearLayout
                    android:id="@+id/formAdd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_add_row"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="15dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="18dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="7dp"
                        android:text="New task"
                        android:textColor="#8FFFFFFF"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etNewTask"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_add"
                            android:hint="What needs doing?"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#61FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/btnAddSubmit"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_button_light"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Add"
                            android:textColor="#24384B"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== footer ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp">

                <LinearLayout
                    android:id="@+id/soundWave"
                    android:layout_width="wrap_content"
                    android:layout_height="13dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="2dp"
                        android:layout_height="5dp"
                        android:background="@drawable/bg_wave_bar" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/bg_wave_bar" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/bg_wave_bar" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/bg_wave_bar" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:letterSpacing="0.02"
                    android:text="Coastal breeze"
                    android:textColor="#78FFFFFF"
                    android:textSize="11sp" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="11dp"
                    android:background="@drawable/bg_dot_small" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="Live wallpaper"
                    android:textColor="#78FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
